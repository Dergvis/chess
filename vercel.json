{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/play/:path(home|login|reset-password|hero-select|account|profile|match|game|result)/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*/",
      "destination": "/api/backend/?route=:path*"
    },
    {
      "source": "/play/:path(home|login|reset-password|hero-select|account|profile|match|game|result)/",
      "destination": "/play/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/reset-password",
      "destination": "/play/reset-password/",
      "permanent": false
    },
    {
      "source": "/play/subscribe",
      "destination": "/play/",
      "permanent": true
    },
    {
      "source": "/play/payment",
      "destination": "/play/",
      "permanent": true
    },
    {
      "source": "/play/payment-success",
      "destination": "/play/",
      "permanent": true
    },
    {
      "source": "/play/billing-required",
      "destination": "/play/",
      "permanent": true
    }
  ]
}
